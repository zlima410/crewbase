# Base URL of the ASP.NET Core API, no trailing slash. Matches the "https" profile
# in api/src/FlooringManager.Api/Properties/launchSettings.json. The API calls
# UseHttpsRedirection, so pointing at the http port (5148) would make every request
# a redirect — run `dotnet dev-certs https --trust` once instead.
VITE_API_BASE_URL=https://localhost:7069

# Supabase project URL and the public, RLS-scoped anon key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
